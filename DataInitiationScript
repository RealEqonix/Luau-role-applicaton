local players = game:GetService("Players")
local runService = game:GetService("RunService")
local replicatedStorage = game:GetService("ReplicatedStorage")
local serverScriptService = game:GetService("ServerScriptService")

local ProfileStore = require(serverScriptService.Libraries.ProfileStore)

local function GetStoreName()
	return runService:IsStudio() and "Test1" or "Live"
end

local Template = require(serverScriptService.Data.Template)
local DataManager = require(serverScriptService.Data.DataManager)

local PlayerStore = ProfileStore.New(GetStoreName(), Template)

local function Initialize(plr: Player, profile: typeof(PlayerStore:StartSessionAsync()))
	
	local leaderstats = Instance.new("Folder", plr)
	leaderstats.Name = "leaderstats"
	
	local shellings = Instance.new("IntValue", leaderstats)
	shellings.Name = "Shellings"
	shellings.Value = profile.Data.Shellings
	
	local savedInventory = profile.Data.SavedInventory
	
	replicatedStorage.Events.UpdateShellingStat:FireClient(plr, profile.Data.Shellings)
	
	for i, itemTable in savedInventory do
		if itemTable["Scale"] then
			
			local newItem = DataManager.deserializeItem(itemTable)
			newItem:AddTag("Sellable")
			newItem.Parent = plr.Backpack
			
		elseif itemTable["Stacked"] then
			
			print("Stackable item unloading")
			
			local newItem = DataManager.deserializeConsumable(itemTable)
			
			newItem.Parent = plr.Backpack
			newItem.Name = (newItem:GetAttribute("ItemName") .." [".. newItem:GetAttribute("Stacked") .."]")
		end
	end
end

replicatedStorage.Events.AddShellings.OnServerEvent:Connect(function(plr: Player, player, amount: number)
	DataManager.AddShellings(plr, amount)
end)

replicatedStorage.Events.RemoveShellings.OnServerEvent:Connect(function(plr: Player, player, amount: number)
	DataManager.RemoveShellings(plr, amount)
end)

local function PlayerAdded(plr: Player)
	
	local profile = PlayerStore:StartSessionAsync("Player_".. plr.UserId, {
		Cancel = function()
			return plr.Parent ~= players
		end,
	})
	
	if profile ~= nil then
		
		profile:AddUserId(plr.UserId)
		profile:Reconcile()
		
		profile.OnSessionEnd:Connect(function()
			DataManager.Profiles[profile] = nil
			plr:Kick("Data error... Please rejoin bruther")
		end)
		
		if plr.Parent == players then
			
			DataManager.Profiles[plr] = profile
			Initialize(plr, profile)
			
		else
			profile:EndSession()
		end
		
	else
		plr:Kick("Data error... Please rejoin my brutha")
	end
end


for _, plr in players:GetPlayers() do
	task.spawn(PlayerAdded, plr)
end

players.PlayerAdded:Connect(PlayerAdded)

players.PlayerRemoving:Connect(function(plr)
	local profile = DataManager.Profiles[plr]
	if not profile then return end
	

	profile:EndSession()
	DataManager.Profiles[plr] = nil
end)
