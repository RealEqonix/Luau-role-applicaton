mouse.Move:Connect(function()
	if not mouse.Target then
		for _, v in workspace.LoadedNoobs:FindFirstChild(plr.Name):GetChildren() do
			if v:FindFirstChild("Highlight") and v ~= mouse.Target then
				v:FindFirstChild("Highlight"):Destroy()
			end
		end
		return
	end
	
	for _, v in workspace.LoadedNoobs:FindFirstChild(plr.Name):GetChildren() do
		if v:FindFirstChild("Highlight") and v ~= mouse.Target then
			v:FindFirstChild("Highlight"):Destroy()
		end
	end
	
	local target = mouse.Target
	
	if target:FindFirstChild("Highlight") then return end
	
	if target.Parent:HasTag("Noob") then
		highlight = Instance.new("Highlight")
		highlight.Name = "Highlight"
		highlight.FillColor = Color3.fromRGB(239, 184, 56)
		highlight.FillTransparency = .5
		
		highlight.Parent = target.Parent
	end
end)

