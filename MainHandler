local function typeText(object,text,length)
	task.spawn(function()
		sfx.Typing:Play()
	end)
	for i = 1,#text,1 do
		object.Text = string.sub(text,1,i)
		wait(length)
	end
end

local function coolDown(textObject)
	local times = 5
	local cooldownObj = textObject.Parent.Parent.Cooldown
	cooldownObj.Enabled = true

	textObject:AddTag("Cooldown")
	
	task.spawn(function()
		repeat 
			times -= 1 
			task.wait(1)
		until times == 0

		cooldownObj.Enabled = false
		textObject:RemoveTag("Cooldown")
	end)
end

local function startQuest(textObj, text, difficulty, r1, r2, r3, reward, requirementList)
	for i, v in requirementList do
		local newInt = v[2]
		local newString = v[1]

		local newRequirement = replicatedStorage.GuiElements.QuestRequirement:Clone()

		newRequirement.Name = newString

		newRequirement:SetAttribute("AmountLeft", tonumber(newInt))
		newRequirement:SetAttribute("RequiredItems", tonumber(newInt))

		newRequirement.Text = ("(".. tonumber(newInt) - newRequirement:GetAttribute("AmountLeft") .."/".. newInt ..") ".. newString)
		newRequirement.Parent = plr.PlayerGui.Main.HUD.Quest.RequirementHolder
	end

	local requirementHolder = plr.PlayerGui.Main.HUD.Quest.RequirementHolder

	local function startFunc(v)
		if v == nil then return end

		local newTable = v:GetAttributes()

		for attributeName, value in newTable do
			task.spawn(function()
				v:GetAttributeChangedSignal(attributeName):Wait()

				print("Noticed Change")

				local textLabel = v

				local RequiredItems = textLabel:GetAttribute("RequiredItems")
				local AmountLeft = textLabel:GetAttribute("AmountLeft")

				if AmountLeft > 0 then
					textLabel.Text = ("(".. RequiredItems - AmountLeft .."/".. RequiredItems ..") ".. textLabel.Name)

					newTable = nil

					task.spawn(startFunc, v)
					return
				else
					textLabel.Text = ("(".. RequiredItems - AmountLeft .."/".. RequiredItems ..") ".. textLabel.Name)

					textLabel.TextColor = BrickColor.new("Lime green")
					textLabel:AddTag("Finished")

					local finishedQuests = 0
					local x = #requirementHolder:GetChildren() - 1

					for i, v in requirementHolder:GetChildren() do
						if v:HasTag("Finished") then
							finishedQuests += 1
						end
					end

					if finishedQuests == x then
						print("Quest Complete")
						coolDown(textObj)
						replicatedStorage.Events.UpdateCredits:FireServer(plr, reward)

						for i, v in requirementHolder:GetChildren() do
							if not v:IsA("UIListLayout") then
								v:Destroy()
							end
						end

						requirementHolder.Parent.Visible = false
						plr.PlayerGui.Main.HUD.Quest.Visible = false
						
						sfx.SellSound:Play()
					end
				end


			end)
		end
	end

	for i, v in requirementHolder:GetChildren() do

		task.spawn(startFunc, v)
	end
end





