		if not v:IsA("UIListLayout") then
			v:Destroy()
		end
	end
	
	plr.PlayerGui.Main.QuestDialogue.Visible = true
	
	for i, v in requirementList do
		local newInt = v[2]
		local newString = v[1]

		local newFrame = replicatedStorage.GuiElements.Requirement:Clone()
		
		newFrame.Text = ("- ".. newString .." ".. newInt)
